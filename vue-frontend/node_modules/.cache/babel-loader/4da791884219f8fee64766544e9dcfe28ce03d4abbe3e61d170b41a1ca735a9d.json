{"ast":null,"code":"import { useRouter } from 'vue-router';\nimport { ElMessage, ElMessageBox } from 'element-plus';\nimport { ChatDotRound, Camera } from '@element-plus/icons-vue';\nexport default {\n  name: 'MenuView',\n  components: {\n    ChatDotRound,\n    Camera\n  },\n  setup() {\n    const router = useRouter();\n    const handleLogout = async () => {\n      try {\n        await ElMessageBox.confirm('确定要退出登录吗？', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        });\n        localStorage.removeItem('token');\n        ElMessage.success('已退出登录');\n        router.push('/login');\n      } catch {\n        // User canceled.\n      }\n    };\n    return {\n      handleLogout\n    };\n  }\n};","map":{"version":3,"names":["useRouter","ElMessage","ElMessageBox","ChatDotRound","Camera","name","components","setup","router","handleLogout","confirm","confirmButtonText","cancelButtonText","type","localStorage","removeItem","success","push"],"sources":["D:\\GoProjects\\ai-chat\\vue-frontend\\src\\views\\Menu.vue"],"sourcesContent":["<template>\n  <div class=\"menu-page\">\n    <header class=\"menu-header\">\n      <h1>AI 应用平台</h1>\n      <el-button type=\"danger\" plain @click=\"handleLogout\">退出登录</el-button>\n    </header>\n\n    <main class=\"menu-main\">\n      <div class=\"menu-grid\">\n        <el-card class=\"menu-item\" shadow=\"never\" @click=\"$router.push('/ai-chat')\">\n          <div class=\"card-content\">\n            <el-icon size=\"40\" color=\"#2563eb\"><ChatDotRound /></el-icon>\n            <h3>AI 聊天</h3>\n            <p>文本对话、RAG 与 MCP 工具调用</p>\n          </div>\n        </el-card>\n\n        <el-card class=\"menu-item\" shadow=\"never\" @click=\"$router.push('/image-recognition')\">\n          <div class=\"card-content\">\n            <el-icon size=\"40\" color=\"#16a34a\"><Camera /></el-icon>\n            <h3>图像识别</h3>\n            <p>上传图片并查看识别结果</p>\n          </div>\n        </el-card>\n      </div>\n    </main>\n  </div>\n</template>\n\n<script>\nimport { useRouter } from 'vue-router'\nimport { ElMessage, ElMessageBox } from 'element-plus'\nimport { ChatDotRound, Camera } from '@element-plus/icons-vue'\n\nexport default {\n  name: 'MenuView',\n  components: {\n    ChatDotRound,\n    Camera\n  },\n  setup() {\n    const router = useRouter()\n\n    const handleLogout = async () => {\n      try {\n        await ElMessageBox.confirm('确定要退出登录吗？', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        })\n        localStorage.removeItem('token')\n        ElMessage.success('已退出登录')\n        router.push('/login')\n      } catch {\n        // User canceled.\n      }\n    }\n\n    return {\n      handleLogout\n    }\n  }\n}\n</script>\n\n<style scoped>\n.menu-page {\n  min-height: 100vh;\n  background: #f6f8fb;\n  padding: 24px;\n}\n\n.menu-header {\n  max-width: 980px;\n  margin: 0 auto;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 24px;\n}\n\n.menu-header h1 {\n  font-size: 28px;\n  color: #111827;\n}\n\n.menu-main {\n  max-width: 980px;\n  margin: 0 auto;\n}\n\n.menu-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n  gap: 18px;\n}\n\n.menu-item {\n  border-radius: 14px;\n  border: 1px solid #e5e7eb;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.menu-item:hover {\n  border-color: #cbd5e1;\n  transform: translateY(-2px);\n  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);\n}\n\n.card-content {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 10px;\n  padding: 8px;\n}\n\n.card-content h3 {\n  font-size: 20px;\n  color: #111827;\n}\n\n.card-content p {\n  color: #64748b;\n}\n</style>\r\n"],"mappings":"AA8BA,SAASA,SAAQ,QAAS,YAAW;AACrC,SAASC,SAAS,EAAEC,YAAW,QAAS,cAAa;AACrD,SAASC,YAAY,EAAEC,MAAK,QAAS,yBAAwB;AAE7D,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IACVH,YAAY;IACZC;EACF,CAAC;EACDG,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIR,SAAS,CAAC;IAEzB,MAAMS,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/B,IAAI;QACF,MAAMP,YAAY,CAACQ,OAAO,CAAC,WAAW,EAAE,IAAI,EAAE;UAC5CC,iBAAiB,EAAE,IAAI;UACvBC,gBAAgB,EAAE,IAAI;UACtBC,IAAI,EAAE;QACR,CAAC;QACDC,YAAY,CAACC,UAAU,CAAC,OAAO;QAC/Bd,SAAS,CAACe,OAAO,CAAC,OAAO;QACzBR,MAAM,CAACS,IAAI,CAAC,QAAQ;MACtB,EAAE,MAAM;QACN;MAAA;IAEJ;IAEA,OAAO;MACLR;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}